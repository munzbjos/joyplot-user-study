# Copy to .env and replace every CHANGE_ME value before deployment.
# Use http://localhost for a local HTTP deployment or a real hostname (without
# a path), e.g. study.example.edu, for Caddy-managed production HTTPS.
SITE_ADDRESS=http://localhost

# Application/database settings
POSTGRES_DB=joyplot
POSTGRES_USER=joyplot
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://joyplot:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@db:5432/joyplot

# Protects researcher-only endpoints such as CSV export.
ADMIN_SECRET=CHANGE_ME_LONG_RANDOM_ADMIN_TOKEN

# One-way HMAC pepper for anonymous session tokens. Generate independently from
# all other secrets; changing it invalidates outstanding participant sessions.
TOKEN_PEPPER=CHANGE_ME_LONG_RANDOM_TOKEN_PEPPER

# Must identify the exact approved consent wording shown to participants.
# Replace this staging placeholder when final consent copy is approved.
CONSENT_TEXT_VERSION=draft-v1

# Non-secret participant-facing build configuration. Replace bracketed copy
# only with researcher-approved final wording before production recruitment.
VITE_MIN_VIEWPORT_WIDTH=1100
VITE_MIN_PARTICIPANT_AGE=18
VITE_CONSENT_TEXT_VERSION=draft-v1
VITE_RESEARCH_INSTITUTION=[Research institution]
VITE_INVESTIGATOR=[Investigator]
VITE_EXPECTED_DURATION=[Expected duration]
VITE_DATA_HANDLING=[Anonymity and data handling information]
VITE_WITHDRAWAL_INFO=[Withdrawal information]
VITE_ETHICS_CONTACT=[Ethics and contact information]
VITE_FINAL_TEXT=Your responses have been recorded.
VITE_TRAINING_JOY_ASSET=
VITE_TRAINING_CH_ASSET=
